# Copy this file to .env.local and fill in the values.

# Supabase — from your project's API settings (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — used by seed script & admin). NEVER expose in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel password — single hardcoded admin for MVP
ADMIN_PASSWORD=change-me

# Site URL — used for email links and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key — for deadline email reminders (Edge Function)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL="SchoolFinder SA <noreply@your-domain.com>"

# ─── Owner analytics dashboard (/owner) ─────────────────────────────────────
# Email(s) allowed into /owner. The account must also be created with
# `npm run create-owner` (see UPDATE.md) — the password is never stored here.
OWNER_EMAIL=you@example.com

# ─── Privacy page ───────────────────────────────────────────────────────────
# Shown on /privacy as the responsible party (POPIA) and contact for requests.
NEXT_PUBLIC_OPERATOR_NAME="Your company name"
NEXT_PUBLIC_CONTACT_EMAIL=privacy@your-domain.co.za

# ─── Optional features (leave unset until the service is configured) ────────
# NEXT_PUBLIC_REMINDERS_ENABLED=true      # after Resend + reminder Edge Function are live
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true    # after Google provider is set up in Supabase Auth
