# Copy this file to .env.local and fill in the values.

# Supabase — from your project's API settings (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — used by seed script & admin). NEVER expose in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel password — single hardcoded admin for MVP
ADMIN_PASSWORD=change-me

# Site URL — used for email links and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key — for deadline email reminders (Edge Function)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL="SchoolFinder SA <noreply@your-domain.com>"
